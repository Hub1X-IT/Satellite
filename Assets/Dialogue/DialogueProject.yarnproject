{
    "projectFileVersion": 4,
    "sourceFiles": [
        "**/*.yarn"
    ],
    "excludeFiles": [
        "**/*~/*",
        "./Samples/Yarn Spinner*/*"
    ],
    "localisation": {
        "en": {
            "assets": "VoiceOverAssets"
        }
    },
    "baseLanguage": "en",
    "compilerOptions": {
        "diagnosticsSeverity": {}
    },
    "editorOptions": {
        "yarnScriptEditor": {
            "characters": [
                {
                    "name": "Lucas",
                    "colour": "#4c8962",
                    "displayName": ""
                },
                {
                    "name": "Samantha",
                    "colour": "#4944da",
                    "displayName": ""
                }
            ],
            "characterColourMode": "unique"
        }
    }
}