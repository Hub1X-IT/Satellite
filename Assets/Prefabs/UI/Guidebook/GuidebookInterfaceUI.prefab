--- !u!114 &3552738524517080846
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5718810370670090482}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Learning Basics\r\n\r\nEvery password used in Seattle is\r\ncoded and
    compressed by one programme.\r\nRemember to decompress it first.\r\nIt converts
    every symbol to text. \r\nFor example the word 'bin' could be \r\nencoded like
    this:\r\n[Decimal]\r\nbin - 98105110\r\n[Hexadecimal]\r\n98105110 - 39 38 31
    30 35 31 31 30\r\n\r\nAs you can see my dear reader, every\r\nsymbol in the password
    is converted\r\nto text, so 9 in ASCII Table changed to\r\nhexadecimal is 39.\r\nYou
    will learn more about different\r\nencoding methods further in the book."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d8737e05ad3a5c54ab90e1abb0b96e15, type: 2}
  m_sharedMaterial: {fileID: 2709866317365345177, guid: d8737e05ad3a5c54ab90e1abb0b96e15, type: 2}
