  m_text: "<style=h1><align=center>Binary Decoding</align></style>\n<indent=20px>1.
    Contains only zeros and ones, nothing else, example: 01101011\n<style=h1><align=center>Octal
    Decoding</align></style>\n<indent=20px>1. Always contains 3 numbers which means
    you might see 0 at the beginning of the code fragment\n2. Ranges are:\n\t060
    to 069 = 0 to 9\n\t101 to 132 = A to Z</indent>"
  m_isRightToLeft: 0
